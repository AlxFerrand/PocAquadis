<Project>

  <!-- Réglages communs à tous les projets de la solution. -->
  <PropertyGroup>
    <!-- Cible unique : un seul endroit à modifier pour changer de version de .NET. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Génère les commentaires XML : le compilateur signale les membres publics non documentés. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Passer à true quand le code aura été compilé une première fois sans avertissement. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
