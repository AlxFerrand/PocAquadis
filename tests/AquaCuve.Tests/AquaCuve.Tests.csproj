<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Les tests sont documentés comme le reste du code, mais pas besoin de l'exiger sur les membres publics. -->
